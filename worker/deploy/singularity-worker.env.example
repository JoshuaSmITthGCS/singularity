# Copy to /etc/singularity-worker.env on the worker VM (chmod 600) and fill in
# real values. Never commit real secrets to the repo.

NEXT_PUBLIC_SUPABASE_URL=https://kjzbjsldezkdhtifmeiu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
WORKER_ID=worker-prod-1
WORKER_POLL_INTERVAL_MS=5000
WORKER_CLAIM_TIMEOUT_MINUTES=10
# How many variants to translate+test in parallel (default 3 if unset). Each
# slot can briefly need ~1 CPU + 512MB during the Docker test stage -- raise
# toward 5 (the number of supported languages) only on a host with the
# headroom for that many concurrent containers.
WORKER_CONCURRENCY=3
